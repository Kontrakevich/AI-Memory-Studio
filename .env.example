# ==================================================
# AI MEMORY STUDIO V3 — OPENROUTER-FIRST
# ==================================================
APP_HOST=0.0.0.0
APP_PORT=8011
APP_TITLE=AI Memory Studio
DATA_ROOT=app/data
PROJECTS_ROOT=app/data/projects

# REQUIRED
OPENROUTER_API_KEY=

# REQUIRED FOR REFERENCE-GUIDED VIDEO + VIDEO QA
# Public HTTPS URL where OpenRouter/provider workers can fetch /media/... assets.
# Example: https://memory.example.com
PUBLIC_BASE_URL=

# Preferred models. The app refreshes OpenRouter catalogs and automatically
# falls back/reroutes when a configured model is unavailable or incompatible.
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_VIDEO_QA_MODEL=openrouter/auto-beta
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# Leave empty to auto-select a current video model that explicitly supports
# first_frame + the requested duration/resolution/aspect ratio.
OPENROUTER_VIDEO_MODEL=

OPENROUTER_GENERATION_TIMEOUT=900
MODEL_REGISTRY_TTL_MINUTES=60

# Product defaults
MEMORY_ASPECT_RATIO=9:16
MEMORY_VIDEO_DURATION=8
MEMORY_VIDEO_RESOLUTION=720p
MEMORY_GENERATE_AUDIO=false
PIPELINE_MAX_RETRIES=2
SOURCE_MAX_PHOTOS_PER_PERIOD=2

DEFAULT_IMAGE_PROVIDER=openrouter
DEFAULT_VIDEO_PROVIDER=openrouter
DEFAULT_LLM_PROVIDER=openrouter

# ==================================================
# LEGACY OPTIONAL PROVIDERS
# Kept only so older project utilities can still run.
# V3 does not require these keys.
# ==================================================
ARK_API_KEY=
SEEDREAM_MODEL=doubao-seedream-4-0-250828
SEEDREAM_SIZE=2K
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-0-260128
SEEDANCE_RATIO=16:9
SEEDANCE_DURATION=15
SEEDANCE_RESOLUTION=720p
SEEDANCE_GENERATE_AUDIO=false
KLING_API_KEY=
KLING_BASE_URL=
KLING_MODEL=
