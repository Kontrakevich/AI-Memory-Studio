APP_HOST=0.0.0.0
APP_PORT=8011
APP_TITLE=AI 1 September Memory Studio
DATA_ROOT=app/data
PROJECTS_ROOT=app/data/projects

# Nano Banana / Gemini through OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# Volcengine Ark: one key for Seedream + Seedance
ARK_API_KEY=
SEEDREAM_MODEL=doubao-seedream-4-0-250828
SEEDREAM_SIZE=2K
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-0-260128
SEEDANCE_RATIO=16:9
SEEDANCE_DURATION=15
SEEDANCE_RESOLUTION=720p
SEEDANCE_GENERATE_AUDIO=false

# Legacy alias if an existing installation already uses this name
SEEDANCE_API_KEY=

# Optional fallback video provider
KLING_API_KEY=
KLING_BASE_URL=
KLING_MODEL=

DEFAULT_IMAGE_PROVIDER=seedream
DEFAULT_VIDEO_PROVIDER=seedance
DEFAULT_LLM_PROVIDER=openrouter
